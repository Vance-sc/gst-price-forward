# SiteGround: prevent Dynamic Cache / browser cache from serving stale board HTML/JSON
# after FTPS deploys. PDF may still be short-cached; HTML and JSON must not stick.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
